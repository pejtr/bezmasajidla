# Database
DATABASE_URL=mysql://user:password@host:3306/bezmasajidla

# JWT secret for session tokens (generate with: openssl rand -base64 32)
JWT_SECRET=change-me-to-a-random-secret

# OAuth (Manus platform)
OAUTH_SERVER_URL=https://your-oauth-server.example.com
VITE_APP_ID=your-app-id
OWNER_OPEN_ID=open-id-of-admin-user

# Mailchimp (optional — newsletter subscription)
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=us21

# OMNIFORGE central publishing control plane
# Meta OAuth, credentials, scheduling, retries and provider calls belong to OMNIFORGE.
# These account IDs are OMNIFORGE SocialAccount IDs, never Meta access tokens.
OMNIFORGE_API_URL=
OMNIFORGE_SERVICE_TOKEN=
OMNIFORGE_BRAND_SLUG=bezmasajidla
OMNIFORGE_FACEBOOK_ACCOUNT_ID=
OMNIFORGE_INSTAGRAM_ACCOUNT_ID=
OMNIFORGE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://www.bezmasajidla.cz

# Port (optional, defaults to 3000)
PORT=3000
